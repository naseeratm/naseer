FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers {
  p { solver GAMG; smoother GaussSeidel; tolerance 1e-6; relTol 0.01; }
  pFinal { $p; relTol 0; }
  U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.05; }
  UFinal { $U; relTol 0; }
  h { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.05; }
  hFinal { $h; relTol 0; }
}
SIMPLE { nNonOrthogonalCorrectors 1; pRefCell 0; pRefValue 0; residualControl { p 1.00e-04; p_rgh 1.00e-04; U 1.00e-04; T 1.00e-04; } }
PISO { nCorrectors 2; nNonOrthogonalCorrectors 0; pRefCell 0; pRefValue 0; }
PIMPLE { momentumPredictor yes; nCorrectors 2; nNonOrthogonalCorrectors 0; nOuterCorrectors 1; }
relaxationFactors { fields { p 0.3; p_rgh 0.3; rho 0.5; } equations { U 0.7; T 0.7; h 0.7; k 0.7; epsilon 0.7; omega 0.7; nuTilda 0.7; } }
