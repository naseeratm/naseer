FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# تثبيت أدوات الشبكة والمحركات الهندسية ومكتبات الرسوميات
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    libgl1 \
    libglu1-mesa \
    libglib2.0-0 \
    libsm6 \
    libxcursor1 \
    libxext6 \
    libxi6 \
    libxinerama1 \
    libxrandr2 \
    libxrender1 \
    gmsh \
    openfoam \
    calculix-ccx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY docker-requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py physics_solver.py universal_dispatcher.py cae_repository.py ./
COPY backend/ ./backend/

# تفعيل بيئة OpenFOAM تلقائياً لأي أمر يتم تنفيذه داخل الحاوية
RUN echo "source /usr/share/openfoam/etc/bashrc" >> /etc/bash.bashrc
ENV WM_PROJECT_DIR=/usr/share/openfoam

CMD ["/opt/venv/bin/celery", "-A", "universal_dispatcher.celery_app", "worker", "--loglevel=INFO", "--concurrency=1"]